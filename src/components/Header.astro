---
// Shared top nav.
//
// The homepage is noindex but the blog is indexable, so an indexed post must not
// hand a visitor a link into the private portfolio. On blog pages the brandmark
// points at /blog instead of /, which keeps the blog usable on its own while
// leaving the homepage reachable only from a link that was sent directly.
const isBlog = Astro.url.pathname.startsWith('/blog');
const brandHref = isBlog ? '/blog' : '/';
---
<nav>
  <div class="nav-in">
    <a class="brandmark" href={brandHref}><span class="mk">NS</span> Nilotpal M. Saharia</a>
    <div class="nav-links">
      <a href="/blog">Blog</a>
      <a class="nav-cta" href="mailto:nilotpalmsaharia@gmail.com">Get in touch</a>
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch theme" title="Switch theme">
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
      </button>
    </div>
  </div>
</nav>
