---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  /** Keep search engines out of a page. Homepage passes true on purpose. */
  noindex?: boolean;
  /** "website" for pages, "article" for blog posts. */
  ogType?: 'website' | 'article';
  /** ISO date string, only used when ogType is "article". */
  publishedTime?: string;
}

const {
  title,
  description = 'Content-led Product Marketing & GTM in B2B SaaS. I turn product into story, then build the tools that turn story into pipeline.',
  noindex = false,
  ogType = 'website',
  publishedTime,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/og.png" />

  <!-- Open Graph. This is what renders when the link is pasted into email,
       LinkedIn, or Slack, which is the site's main distribution. -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Nilotpal M. Saharia" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Nilotpal M. Saharia, Content-led Product Marketing and GTM in B2B SaaS" />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Runs before first paint: applies a saved theme so the page never flashes
       the wrong one, and adds .js so reveal styles apply without a flash.
       Must stay inline and must stay above the stylesheet link. -->
  <script is:inline>
    (function () {
      var r = document.documentElement;
      try {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') r.setAttribute('data-theme', t);
      } catch (e) { /* private mode, blocked storage: fall through to the OS setting */ }
      r.classList.add('js');
    })();
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <slot />

  <script is:inline>
    (function () {
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      var root = document.documentElement;
      var mq = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;

      // Effective theme is the explicit choice if there is one, else the OS.
      function current() {
        var set = root.getAttribute('data-theme');
        if (set === 'dark' || set === 'light') return set;
        return mq && mq.matches ? 'dark' : 'light';
      }
      function label() {
        var next = current() === 'dark' ? 'light' : 'dark';
        btn.setAttribute('aria-label', 'Switch to ' + next + ' theme');
        btn.setAttribute('title', 'Switch to ' + next + ' theme');
      }
      btn.addEventListener('click', function () {
        var next = current() === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
        label();
      });
      // Keep the label honest if the OS flips while no explicit choice is set.
      if (mq && mq.addEventListener) mq.addEventListener('change', label);
      label();
    })();
  </script>

  <!-- Scroll-reveal. Two safety nets, because .js hides every .reveal up front:
       if IntersectionObserver is missing or this script throws, and if anything
       is still hidden shortly after load, everything is forced visible. -->
  <script is:inline>
    (function () {
      var els = document.querySelectorAll('.reveal');
      var showAll = function () {
        for (var i = 0; i < els.length; i++) els[i].classList.add('in');
      };
      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduced || !('IntersectionObserver' in window)) { showAll(); return; }

      try {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.12 });

        for (var i = 0; i < els.length; i++) {
          els[i].style.transitionDelay = (Math.min(i % 6, 5) * 60) + 'ms';
          io.observe(els[i]);
        }
        // Last resort: never leave content invisible.
        window.addEventListener('load', function () { setTimeout(showAll, 1500); });
      } catch (err) {
        showAll();
      }
    })();
  </script>
</body>
</html>
