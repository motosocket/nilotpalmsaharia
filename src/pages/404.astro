---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Page not found | Nilotpal M. Saharia" noindex={true}>
  <Header />

  <main id="main">
    <div class="wrap page-head">
      <h1 class="reveal">Page not found</h1>
      <p class="reveal">That link does not point anywhere. The writing is still where it should be.</p>
      <div class="cta reveal" style="margin-top:28px">
        <a class="btn primary" href="/blog">Read the blog</a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
